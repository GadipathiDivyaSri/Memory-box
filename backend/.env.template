# ==============================================================================
# MemoryBox: Production Environment Template
# ==============================================================================
# Copy this file to .env and populate with your credentials.
# NEVER commit actual secrets or credentials to version control.

# Application Configuration
APP_NAME="MemoryBox Digital Heritage Vault"
ENVIRONMENT="development" # development | staging | production
DEBUG=False
PORT=8080

# Google Cloud Platform & Gemini AI
GOOGLE_CLOUD_PROJECT="memorybox-heritage-vault"
GOOGLE_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# Google Cloud Storage (Media Vault: Audio, Photos, Documents)
GCS_BUCKET_NAME="memorybox-heritage-media"
GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account.json"

# Firebase & Firestore Credentials
FIREBASE_PROJECT_ID="memorybox-heritage-vault"
FIREBASE_CREDENTIALS_PATH="" # Optional if using Application Default Credentials (ADC)
FIRESTORE_DATABASE_ID="(default)"

# Google Cloud Speech & Audio
GOOGLE_SPEECH_LANGUAGE_CODE="en-IN" # en-IN, hi-IN, te-IN, ta-IN, bn-IN, etc.
GOOGLE_TTS_VOICE_NAME="en-IN-Wavenet-D"

# Google Maps Platform (For Geocoding & Heritage Mapping)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Security & Authentication (JWT + 2FA)
# Generate a 64-character secret: openssl rand -hex 32
JWT_SECRET_KEY="generate-a-strong-random-secret-key-for-jwt-signing"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 Hours
TWO_FACTOR_ISSUER="MemoryBoxVault"

# Security & Governance Limits
RATE_LIMIT_PER_MINUTE=100
MAX_AUDIO_SIZE_BYTES=52428800   # 50 MB
MAX_PHOTO_SIZE_BYTES=20971520   # 20 MB
MAX_VIDEO_SIZE_BYTES=209715200  # 200 MB

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:8501,http://127.0.0.1:8501,https://*.streamlit.app"
